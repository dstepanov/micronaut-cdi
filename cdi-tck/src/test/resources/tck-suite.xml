<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<!-- The part of the kit that runs through the Arquillian adapter. It grows as conformance does: a package is
     added when the implementation is ready to be held to it, and what is not on it is not yet claimed. -->
<suite name="CDI Lite TCK" verbose="1" configfailurepolicy="continue">
    <!-- core mode: what the kit marks as CDI Full does not run against CDI Lite. Each test of the Lite part
         says so itself rather than the suite saying it for all of them, so that the last test can run the few
         classes of CDI Full that are claimed beyond Lite -->
    <test name="definition">
        <groups>
            <run>
                <exclude name="cdi-full"/>
            </run>
        </groups>
        <packages>
            <package name="org.jboss.cdi.tck.tests.definition.qualifier.*"/>
            <package name="org.jboss.cdi.tck.tests.definition.scope.*"/>
            <package name="org.jboss.cdi.tck.tests.definition.stereotype.*"/>
            <package name="org.jboss.cdi.tck.tests.definition.name.*"/>
            <package name="org.jboss.cdi.tck.tests.definition.bean.*"/>
            <package name="org.jboss.cdi.tck.tests.vetoed.*"/>
        </packages>
    </test>
    <test name="discovery-and-resolution">
        <groups>
            <run>
                <exclude name="cdi-full"/>
            </run>
        </groups>
        <packages>
            <package name="org.jboss.cdi.tck.tests.inheritance.generics"/>
            <package name="org.jboss.cdi.tck.tests.alternative.resolution.qualifier"/>
            <package name="org.jboss.cdi.tck.tests.alternative.selection"/>
            <package name="org.jboss.cdi.tck.tests.alternative.selection.priority"/>
            <package name="org.jboss.cdi.tck.tests.alternative.selection.stereotype.priority"/>
            <package name="org.jboss.cdi.tck.tests.deployment.discovery"/>
            <package name="org.jboss.cdi.tck.tests.beanContainer"/>
            <package name="org.jboss.cdi.tck.tests.beanContainer.assignability"/>
            <package name="org.jboss.cdi.tck.tests.beanContainer.bytype"/>
            <package name="org.jboss.cdi.tck.tests.beanContainer.injection"/>
            <package name="org.jboss.cdi.tck.tests.context"/>
            <package name="org.jboss.cdi.tck.tests.context.alterable"/>
            <package name="org.jboss.cdi.tck.tests.context.dependent"/>
            <package name="org.jboss.cdi.tck.tests.context.dependent.instance"/>
            <package name="org.jboss.cdi.tck.tests.context.dependent.transientreference"/>
        </packages>
    </test>
    <test name="lookup">
        <groups>
            <run>
                <exclude name="cdi-full"/>
            </run>
        </groups>
        <packages>
            <package name="org.jboss.cdi.tck.tests.lookup.*"/>
        </packages>
    </test>
    <test name="implementation">
        <groups>
            <run>
                <exclude name="cdi-full"/>
            </run>
        </groups>
        <packages>
            <package name="org.jboss.cdi.tck.tests.implementation.*"/>
        </packages>
    </test>
    <test name="interceptors">
        <groups>
            <run>
                <exclude name="cdi-full"/>
            </run>
        </groups>
        <packages>
            <package name="org.jboss.cdi.tck.tests.interceptors.*"/>
            <package name="org.jboss.cdi.tck.interceptors.tests.*"/>
        </packages>
    </test>
    <test name="build-compatible-extensions">
        <groups>
            <run>
                <exclude name="cdi-full"/>
            </run>
        </groups>
        <packages>
            <package name="org.jboss.cdi.tck.tests.build.compatible.extensions.*"/>
        </packages>
    </test>
    <test name="event">
        <groups>
            <run>
                <exclude name="cdi-full"/>
            </run>
        </groups>
        <packages>
            <package name="org.jboss.cdi.tck.tests.event.*"/>
        </packages>
    </test>
    <!-- The SE bootstrap tests, listed by class: the ones left out depend on what belongs to CDI Full and is
         not pretended here - portable extensions (customClassloader, customCDIProvider's neighbours aside,
         context.custom), decorators, and InterceptionFactory (discovery.trimmed) - each recorded in
         CONFORMANCE.md -->
    <test name="invokers">
        <groups>
            <run>
                <exclude name="cdi-full"/>
            </run>
        </groups>
        <packages>
            <package name="org.jboss.cdi.tck.tests.invokers.*"/>
        </packages>
    </test>
    <test name="se">
        <groups>
            <run>
                <exclude name="cdi-full"/>
            </run>
        </groups>
        <classes>
            <class name="org.jboss.cdi.tck.tests.se.container.BootstrapSEContainerTest">
                <methods>
                    <!-- decorators belong to CDI Full. The two tests that hand the bootstrap a portable extension
                         run: the subset of that lifecycle a container of compiled beans answers is provided
                         beyond Lite by micronaut-cdi-reflection, see CONFORMANCE.md -->
                    <exclude name="testAddDecorator"/>
                </methods>
            </class>
            <class name="org.jboss.cdi.tck.tests.se.container.contextualReference.InvalidContextualReferenceTest"/>
            <class name="org.jboss.cdi.tck.tests.se.context.ContextSETest"/>
            <class name="org.jboss.cdi.tck.tests.se.context.activation.interceptor.ActivateRequestContextByInterceptorTest"/>
            <class name="org.jboss.cdi.tck.tests.se.context.activation.programmatic.ActivateRequestContextProgrammaticallyTest"/>
            <class name="org.jboss.cdi.tck.tests.se.context.request.RequestContextTest"/>
            <!-- portable extensions found through the service loader of the bootstrap's class loader: one adds a
                 qualifier to a bean class, the other replaces the request context with its own -->
            <class name="org.jboss.cdi.tck.tests.se.container.customClassloader.CustomClassLoaderSETest"/>
            <class name="org.jboss.cdi.tck.tests.se.context.custom.CustomRequestContextSETest"/>
            <class name="org.jboss.cdi.tck.tests.se.customCDIProvider.CustomCDIProviderTest"/>
            <class name="org.jboss.cdi.tck.tests.se.discovery.implicit.ImplicitBeanArchiveSETest"/>
            <class name="org.jboss.cdi.tck.tests.se.discovery.implicit.ImplicitBeanArchiveWithSystemPropertyTest"/>
            <class name="org.jboss.cdi.tck.tests.se.events.lifecycle.StartupShutdownTest"/>
        </classes>
    </test>
    <!-- Beyond Lite: classes the kit marks as CDI Full that pass here all the same, because what they assert
         is within what this implementation answers - the bean manager's comparison of qualifiers, its injectable
         references, interceptors bound with @Interceptors, and the expression language. They are listed by class and nothing of the
         cdi-full group is excluded here; CDI Full as a whole is still not claimed, and CONFORMANCE.md counts
         these apart from the Lite tests -->
    <test name="beyond-lite">
        <classes>
            <class name="org.jboss.cdi.tck.tests.full.extensions.beanManager.equivalence.qualifier.QualifierEquivalenceTest"/>
            <class name="org.jboss.cdi.tck.tests.full.lookup.injectionpoint.broken.reference.ambiguous.AmbiguousInjectableReferenceTest"/>
            <class name="org.jboss.cdi.tck.tests.full.lookup.injectionpoint.broken.reference.unresolved.UnsatisfiedInjectableReferenceTest"/>
            <class name="org.jboss.cdi.tck.tests.full.interceptors.tests.contract.method.MethodLevelInterceptorTest"/>
            <class name="org.jboss.cdi.tck.tests.full.interceptors.contract.invocationContext.InterceptorBindingsWithAtInterceptorsTest"/>
            <class name="org.jboss.cdi.tck.tests.full.interceptors.definition.interceptorOrder.InterceptorOrderTest"/>
            <!-- decorators are not implemented, and asking for the metadata of one is refused as the
                 definition error the specification makes it -->
            <class name="org.jboss.cdi.tck.tests.full.implementation.builtin.metadata.broken.injection.BuiltinDecoratorInjectionTest"/>
            <class name="org.jboss.cdi.tck.tests.full.implementation.builtin.metadata.broken.injection.decorated.DecoratedBeanConstructorInjectionTest"/>
            <class name="org.jboss.cdi.tck.tests.full.implementation.builtin.metadata.broken.injection.decorated.DecoratedBeanFieldInjectionTest"/>
            <class name="org.jboss.cdi.tck.tests.full.implementation.builtin.metadata.broken.injection.decorated.DecoratedBeanInitializerInjectionTest"/>
            <!-- the expression language, through the optional micronaut-cdi-el module: names resolved to beans,
                 and the dependent beans of an evaluation shared within it and destroyed after it -->
            <class name="org.jboss.cdi.tck.tests.full.lookup.el.ResolutionByNameTest"/>
            <class name="org.jboss.cdi.tck.tests.full.context.dependent.DependentContextTest"/>
            <class name="org.jboss.cdi.tck.tests.full.extensions.beanManager.el.WrapExpressionFactoryTest"/>
        </classes>
    </test>
</suite>
